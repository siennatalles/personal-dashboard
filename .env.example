# Copy this file to .env and fill in your own credentials.
# Every integration is optional — the dashboard runs in DEMO_MODE with synthetic
# data for anything you haven't configured yet.

# Set to "false" once you've filled in real credentials below.
DEMO_MODE=true

# --- Apple Calendar (CalDAV) ---
# 1. On your iPhone/Mac: Settings > [your name] > Sign-In & Security >
#    App-Specific Passwords > Generate. Requires 2FA enabled on your Apple ID.
# 2. APPLE_ID is the email you sign into iCloud with.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# --- Gmail (IMAP, personal accounts only — not Google Workspace) ---
# 1. Enable 2-Step Verification on your Google account (myaccount.google.com/security).
# 2. Go to https://myaccount.google.com/apppasswords and generate an app
#    password for "Mail" — use that below, NOT your normal Gmail password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Canvas LMS ---
# 1. Log into your school's Canvas site.
# 2. Account > Settings > Approved Integrations > "+ New Access Token".
# 3. CANVAS_BASE_URL is your school's Canvas domain, e.g.
#    https://yourschool.instructure.com
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=

# --- Weather (Open-Meteo, no API key needed) ---
# Set to a city name (e.g. "St. Louis, MO") or a "lat,lon" pair to skip
# the geocoding lookup entirely. Nothing to sign up for — this is the only
# integration in the project that needs zero credentials.
WEATHER_LOCATION=

# --- AI daily briefing (optional) ---
# Powers the short narrative summary at the top of the dashboard ("Today: 3
# events, 1 urgent email..."). Without this, it falls back to a simple
# rule-based (non-AI) version of the same summary — nothing breaks either way.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
